{
  "name": "elsevier-mcp",
  "projectType": "library",
  "sourceRoot": "packages/elsevier-mcp/elsevier_mcp",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../.venv/bin/pytest tests/ -v --cov=elsevier_mcp --cov-report=term-missing",
        "cwd": "packages/elsevier-mcp"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../.venv/bin/ruff check elsevier_mcp tests elsevier_mcp_complete.py test.py",
        "cwd": "packages/elsevier-mcp"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../.venv/bin/python3 -m build --no-isolation",
        "cwd": "packages/elsevier-mcp"
      }
    }
  }
}
