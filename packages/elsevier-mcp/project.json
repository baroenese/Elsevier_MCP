{
  "name": "elsevier-mcp",
  "projectType": "library",
  "sourceRoot": "packages/elsevier-mcp/elsevier_mcp",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../.venv/bin/pytest tests/ -v",
        "cwd": "packages/elsevier-mcp"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../.venv/bin/python3 -m compileall -q elsevier_mcp tests elsevier_mcp_complete.py",
        "cwd": "packages/elsevier-mcp"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../.venv/bin/python3 -m build --no-isolation",
        "cwd": "packages/elsevier-mcp"
      }
    }
  }
}
