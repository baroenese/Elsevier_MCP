{
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next dev --port 3000",
        "cwd": "apps/web"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next build",
        "cwd": "apps/web"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next start --port 3000",
        "cwd": "apps/web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next lint",
        "cwd": "apps/web"
      }
    }
  }
}
