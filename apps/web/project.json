{
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next dev --port 3000",
        "cwd": "apps/web"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next build",
        "cwd": "apps/web"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next start --port 3000",
        "cwd": "apps/web"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit -p apps/web/tsconfig.json && node --test --experimental-strip-types apps/web/tests/*.test.ts",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint apps/web --max-warnings=0 && npx tsc --noEmit -p apps/web/tsconfig.json",
        "cwd": "."
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next build && npx playwright test",
        "cwd": "apps/web"
      }
    }
  }
}
